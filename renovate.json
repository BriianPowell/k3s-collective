{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "enabledManagers": [
    "flux",
    "kubernetes"
  ],
  "flux": {
    "managerFilePatterns": [
      "/^apps\\/.+\\.ya?ml$/",
      "/^infrastructure\\/.+\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^apps\\/.+\\.ya?ml$/",
      "/^infrastructure\\/.+\\.ya?ml$/"
    ]
  },
  "ignorePaths": [
    "clusters/k3s/flux-system/**",
    ".memories/**"
  ],
  "labels": [
    "dependencies"
  ],
  "dependencyDashboard": true,
  "prConcurrentLimit": 5,
  "prHourlyLimit": 3,
  "automerge": false,
  "separateMajorMinor": true,
  "packageRules": [
    {
      "description": "These images are updated by Flux image automation (image-automation.yaml files). A second updater would fight it. Add a new automation's image here.",
      "matchPackageNames": [
        "/(^|\\/)binwiederhier\\/ntfy$/",
        "/(^|\\/)eclipse-mosquitto$/",
        "/(^|\\/)mrcas\\/kapowarr$/",
        "/(^|\\/)ngosang\\/deluge-exporter$/",
        "/(^|\\/)nwalke\\/tautulli_exporter$/",
        "/(^|\\/)requarks\\/wiki$/",
        "/(^|\\/)ghcr\\.io\\/atuinsh\\/atuin$/",
        "/(^|\\/)ghcr\\.io\\/axsuul\\/plex-media-server-exporter$/",
        "/(^|\\/)ghcr\\.io\\/binhex\\/arch-delugevpn$/",
        "/(^|\\/)ghcr\\.io\\/flaresolverr\\/flaresolverr$/",
        "/(^|\\/)ghcr\\.io\\/henrywhitaker3\\/adguard-exporter$/",
        "/(^|\\/)ghcr\\.io\\/home-assistant\\/home-assistant$/",
        "/(^|\\/)ghcr\\.io\\/linuxserver\\/bazarr$/",
        "/(^|\\/)ghcr\\.io\\/linuxserver\\/kavita$/",
        "/(^|\\/)ghcr\\.io\\/linuxserver\\/lidarr$/",
        "/(^|\\/)ghcr\\.io\\/linuxserver\\/prowlarr$/",
        "/(^|\\/)ghcr\\.io\\/linuxserver\\/radarr$/",
        "/(^|\\/)ghcr\\.io\\/linuxserver\\/sonarr$/",
        "/(^|\\/)ghcr\\.io\\/onedr0p\\/exportarr$/",
        "/(^|\\/)ghcr\\.io\\/recyclarr\\/recyclarr$/",
        "/(^|\\/)ghcr\\.io\\/seerr-team\\/seerr$/",
        "/(^|\\/)ghcr\\.io\\/tarampampam\\/error-pages$/",
        "/(^|\\/)ghcr\\.io\\/tautulli\\/tautulli$/",
        "/(^|\\/)ghcr\\.io\\/willfantom\\/overseerr-exporter$/",
        "/(^|\\/)quay\\.io\\/keycloak\\/keycloak$/",
        "/(^|\\/)quay\\.io\\/prometheuscommunity\\/smartctl-exporter$/"
      ],
      "enabled": false
    },
    {
      "description": "Flux's own components are upgraded by hand with `flux install --export` (see AGENTS.md), after `flux migrate`.",
      "matchPackageNames": [
        "fluxcd/flux2"
      ],
      "enabled": false
    },
    {
      "description": "Registries and datasources without usable release timestamps are exempt from the cooldown, as are update types that have no release age.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/**",
        "quay.io/**",
        "registry.k8s.io/**"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "git, kubernetes-api and lock-file updates carry no release timestamp.",
      "matchDatasources": [
        "git-refs",
        "git-tags",
        "kubernetes-api"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "Keep Flux HelmRelease chart versions free of digests.",
      "matchManagers": [
        "flux"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchDepTypes": [
        "HelmChart"
      ],
      "pinDigests": false
    }
  ],
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-required"
}
